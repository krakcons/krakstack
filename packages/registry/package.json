{
  "name": "@krak-stack/registry",
  "version": "0.1.0",
  "description": "KrakStack shadcn registry manifests for components, services, and project configuration.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krakcons/krakstack-site.git",
    "directory": "packages/registry"
  },
  "files": ["dist", "README.md"],
  "exports": {
    ".": "./dist/registry.json",
    "./package.json": "./package.json",
    "./*.json": "./dist/*.json",
    "./*": "./dist/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun --cwd ../.. run registry:build && bun run build.ts",
    "prepack": "bun run build"
  }
}
