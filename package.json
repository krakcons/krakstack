{
  "name": "site",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run registry:package:build && bun --bun vite dev --port 3003",
    "build": "bun run registry:package:build && bun --bun vite build",
    "start": "bun run server.ts",
    "preview": "bun --bun vite preview",
    "test": "bun run registry:package:build && bun --bun vitest run",
    "registry:build": "bun -e 'import { readdirSync, readFileSync, rmSync } from \"node:fs\"; const names = new Set(JSON.parse(readFileSync(\"registry.json\", \"utf8\")).items.map((item) => item.name)); for (const file of readdirSync(\"public/r\")) { if (file === \"registry.json\" || !file.endsWith(\".json\")) continue; const item = JSON.parse(readFileSync(`public/r/${file}`, \"utf8\")); if (!names.has(item.name)) rmSync(`public/r/${file}`); }' && shadcn build && bun fmt public/r/*.json",
    "registry:package:build": "bun run --cwd packages/registry build",
    "registry:package:pack": "bun pm --cwd packages/registry pack",
    "registry:package:pack:dev": "mkdir -p tmp && bun pm --cwd packages/registry pack --filename \"$PWD/tmp/registry-effect4.tgz\"",
    "notifications:build": "bun run --cwd packages/notifications build",
    "notifications:check": "bun run --cwd packages/notifications check",
    "notifications:test": "bun run --cwd packages/notifications test",
    "notifications:typecheck": "bun run --cwd packages/notifications typecheck",
    "notifications:pack": "bun pm --cwd packages/notifications pack",
    "assets:build": "bun run --cwd packages/assets build",
    "assets:check": "bun run --cwd packages/assets check",
    "assets:test": "bun run --cwd packages/assets test",
    "assets:typecheck": "bun run --cwd packages/assets typecheck",
    "assets:pack": "bun pm --cwd packages/assets pack",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "lint": "oxlint",
    "prepare": "bun run registry:package:build && effect-tsgo patch",
    "shadcn:update": "for file in src/components/ui/*.tsx; do bunx shadcn@latest add -y -o $(basename \"$file\" .tsx); done"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1068.0",
    "@base-ui/react": "^1.5.0",
    "@effect/ai-openai": "4.0.0",
    "@effect/ai-openai-compat": "4.0.0",
    "@effect/atom-react": "4.0.0",
    "@effect/platform-browser": "4.0.0",
    "@effect/sql-pg": "4.0.0",
    "@iconify/react": "^6.0.2",
    "@krak-stack/registry": "workspace:*",
    "@lucas-barake/effect-form": "1.1.0",
    "@lucas-barake/effect-form-react": "1.1.0",
    "@shadcn/react": "^0.2.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/highlight": "^0.0.10",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/react-virtual": "^3.14.5",
    "@xberg-io/xberg": "1.0.14",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^1.0.0-rc.4-5d5b77c",
    "effect": "4.0.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@better-auth/api-key": "^1.6.18",
    "@changesets/cli": "3.0.3",
    "@effect/sql-sqlite-node": "4.0.0",
    "@effect/tsgo": "0.14.6",
    "@effect/vitest": "4.0.0",
    "@inlang/paraglide-js": "^2.19.0",
    "@krak-stack/auth": "0.2.27",
    "@oxlint/plugins": "1.78.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "latest",
    "@vitejs/plugin-react": "^6.0.2",
    "better-auth": "^1.6.18",
    "drizzle-kit": "^1.0.0-rc.4-ca0f029",
    "jsdom": "^28.1.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.1-rc",
    "vite": "^8.1.6",
    "vitest": "^5.0.3"
  }
}
