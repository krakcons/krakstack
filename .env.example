VITE_SITE_URL=http://localhost:3003
# Stable server-only secret, at least 32 characters. Events are not stored in SQL.
APP_SECRET=replace-with-a-random-secret-at-least-32-characters

# The same-origin /api/otel proxy forwards browser traces and events here.
OTEL_SERVICE_NAME=krakstack-site-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
